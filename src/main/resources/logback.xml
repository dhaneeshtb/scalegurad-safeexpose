<configuration debug="false">
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%msg%n</pattern>
    </encoder>
  </appender>

  <!-- SafeExpose prints its own status lines. Library chatter (SSH host-key warnings, session events) is hidden;
       start with -DsafeexposeLog=INFO (or DEBUG) to see it. -->
  <root level="${safeexposeLog:-ERROR}">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
